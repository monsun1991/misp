{
  "name": "mips-be",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch 'src/**/*.ts' --exec ts-node src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "clean": "rm -rf build dist",
    "rebuild": "npm run clean && npm run build",
    "seed:setup": "ts-node src/scripts/setup-seed.ts"
  },
  "keywords": [
    "express",
    "typeorm",
    "mips",
    "rest-api"
  ],
  "author": "",
  "license": "ISC",
  "description": "MIPS REST API - Manufacturing Inventory & Planning System",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "http-status": "^2.1.0",
    "ioredis": "^5.4.2",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "moment-timezone": "^0.6.0",
    "morgan": "^1.10.0",
    "mysql2": "^3.15.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.27",
    "uuid": "^8.3.2",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.19",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^24.7.0",
    "@types/uuid": "^10.0.0",
    "axios": "^1.12.2",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
